{
  "_id": "{{@ system @}}",
  "authentication": "basic",
  "operations": {
    "customers-delete": {
      "method": "DELETE",
      "url": "v3/customers/{{ entity.id }}"
    },
    "customers-insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/customers"
    },
    "customers-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{%if (headers.Link is defined)%}{{headers.Link.next}}{%endif%}",
      "next_page_termination_strategy": [
        "not-full-page",
        "next-page-link-empty",
        "empty-result"
      ],
      "page_size": 10,
      "url": "v3/customers?per_page={{page_size}}"
    },
    "customers-lookup": {
      "method": "GET",
      "url": "v3/customers/{{ entity.id }}"
    },
    "customers-update": {
      "method": "PUT",
      "url": "v3/customers/{{ entity.id }}"
    },
    "orders-delete": {
      "method": "DELETE",
      "url": "v3/orders/{{ entity.id }}"
    },
    "orders-insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/orders"
    },
    "orders-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{%if (headers.Link is defined)%}{{headers.Link.next}}{%endif%}",
      "next_page_termination_strategy": [
        "not-full-page",
        "next-page-link-empty",
        "empty-result"
      ],
      "page_size": 10,
      "since_property_name": "modified_after",
      "updated_expression": "{{date_modified_gmt}}",
      "url": "v3/orders?per_page={{page_size}}"
    },
    "orders-lookup": {
      "method": "GET",
      "url": "v3/orders/{{ entity.id }}"
    },
    "orders-update": {
      "method": "PUT",
      "url": "v3/orders/{{ entity.id }}"
    },
    "products-delete": {
      "method": "DELETE",
      "url": "v3/products/{{ entity.id }}"
    },
    "products-insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/products"
    },
    "products-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{%if (headers.Link is defined)%}{{headers.Link.next}}{%endif%}",
      "next_page_termination_strategy": [
        "not-full-page",
        "next-page-link-empty",
        "empty-result"
      ],
      "page_size": 10,
      "since_property_name": "modified_after",
      "updated_expression": "{{date_modified_gmt}}",
      "url": "v3/products?per_page={{ page_size }}"
    },
    "products-lookup": {
      "method": "GET",
      "url": "v3/products/{{ entity.id }}"
    },
    "products-update": {
      "method": "PUT",
      "url": "v3/products/{{ entity.id }}"
    },
    "productvariations-lookup": {
      "method": "GET",
      "url": "v3/products/{{ entity.id }}/variations"
    }
  },
  "password": "$SECRET(api_key)",
  "type": "system:rest",
  "url_pattern": "https://{{@ domain @}}/wp-json/wc/%s",
  "username": "{{@ consumer_key @}}",
  "verify_ssl": true
}