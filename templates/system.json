{
  "_id": "{{@ system @}}",
  "authentication": "basic",
  "operations": {
    "customer-delete": {
      "method": "DELETE",
      "url": "v3/customers/{{ entity.id }}"
    },
    "customer-insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/customers"
    },
    "customer-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{%if (headers.Link is defined)%}{{headers.Link.next}}{%endif%}",
      "next_page_termination_strategy": [
        "not-full-page",
        "next-page-link-empty",
        "empty-result"
      ],
      "page_size": 10,
      "since_property_name": "modified_after",
      "updated_expression": "{{date_modified_gmt}}",
      "url": "v3/customers?per_page={{page_size}}"
    },
    "customer-lookup": {
      "method": "GET",
      "url": "v3/customers/{{ entity.id }}"
    },
    "customer-update": {
      "method": "PUT",
      "url": "v3/customers/{{ entity.id }}"
    },
    "order-delete": {
      "method": "DELETE",
      "url": "v3/orders/{{ entity.id }}"
    },
    "order-insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/orders"
    },
    "order-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{%if (headers.Link is defined)%}{{headers.Link.next}}{%endif%}",
      "next_page_termination_strategy": [
        "not-full-page",
        "next-page-link-empty",
        "empty-result"
      ],
      "page_size": 10,
      "since_property_name": "modified_after",
      "updated_expression": "{{date_modified_gmt}}",
      "url": "v3/orders?per_page={{page_size}}"
    },
    "order-lookup": {
      "method": "GET",
      "url": "v3/orders/{{ entity.id }}"
    },
    "order-update": {
      "method": "PUT",
      "url": "v3/orders/{{ entity.id }}"
    },
    "product-delete": {
      "method": "DELETE",
      "url": "v3/products/{{ entity.id }}"
    },
    "product-insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/products"
    },
    "product-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{%if (headers.Link is defined)%}{{headers.Link.next}}{%endif%}",
      "next_page_termination_strategy": [
        "not-full-page",
        "next-page-link-empty",
        "empty-result"
      ],
      "page_size": 10,
      "since_property_name": "modified_after",
      "updated_expression": "{{date_modified_gmt}}",
      "url": "v3/products?per_page={{ page_size }}"
    },
    "product-lookup": {
      "method": "GET",
      "url": "v3/products/{{ entity.id }}"
    },
    "product-update": {
      "method": "PUT",
      "url": "v3/products/{{ entity.id }}"
    },
    "productvariation-lookup": {
      "method": "GET",
      "url": "v3/products/{{ entity.id }}/variations"
    },
    "webhook-delete": {
      "method": "DELETE",
      "payload-type": "json",
      "url": "v3/webhooks/{{ entity['id'] }}?force=true"
    },
    "webhook-insert": {
      "id_expression": "{{ insert_response.id }}",
      "method": "POST",
      "payload": {
        "delivery_url": "{{ properties.deliveryUrl }}",
        "name": "{{ properties.datatype}}",
        "topic": "{{ properties.topic}}"
      },
      "payload-type": "json",
      "url": "v3/webhooks"
    },
    "webhook-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "url": "v3/webhooks"
    },
    "webhook-lookup": {
      "method": "GET",
      "payload-type": "json",
      "url": "v3/webhooks/{{ entity['id'] }}"
    }
  },
  "password": "$SECRET(api_key)",
  "type": "system:rest",
  "url_pattern": "https://{{@ domain @}}/wp-json/wc/%s",
  "username": "{{@ consumer_key @}}",
  "verify_ssl": true
}