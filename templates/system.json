{
  "_id": "{{@ system @}}",
  "authentication": "basic",
  "operations": {
    "insert": {
      "method": "POST",
      "payload-type": "json",
      "url": "v3/{{ properties.datatype }}"
    },
    "list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "url": "v3/{{ properties.datatype }}"
    },
    "lookup": {
      "method": "GET",
      "url": "v3/{{ properties.datatype }}/{{ entity.id }}"
    },
    "update": {
      "method": "PUT",
      "url": "v3/{{ properties.datatype }}/{{ entity.id }}"
    }
  },
  "password": "$SECRET(api_key)",
  "type": "system:rest",
  "url_pattern": "https://{{@ domain @}}/wp-json/wc/%s",
  "username": "{{@ consumer_key @}}",
  "verify_ssl": true
}